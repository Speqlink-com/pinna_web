# Vercel server environment. No database, SMTP or Google secrets are needed on Vercel.
APP_ORIGIN=https://pinnaa.com
PINNA_API_URL=https://api.pinnaa.com
# Must match the backend WEB_PROXY_KEY; never use a NEXT_PUBLIC_* variable.
PINNA_WEB_PROXY_KEY=
ENABLE_DESIGN_PREVIEWS=false
# Local development: APP_ORIGIN=http://localhost:3000, PINNA_API_URL=http://127.0.0.1:8000
# Identity, database migrations, mail delivery and seeding run in pinna_infra.
