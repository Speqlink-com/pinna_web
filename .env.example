# Copy to .env.local. Keep real credentials out of version control.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pinna:pinna@localhost:5432/pinna
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: <APP_ORIGIN>/api/v1/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pinna <no-reply@example.com>
# Seed once, then remove these from the runtime environment.
SUPER_ADMIN_NAME=Platform owner
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Local-only synthetic previews are on in development and off in production.
ENABLE_DESIGN_PREVIEWS=false
